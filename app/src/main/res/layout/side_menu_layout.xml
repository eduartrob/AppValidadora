<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="280dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="@color/white"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/navHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorNavy"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardUserIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="4dp"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:src="@drawable/ic_user"
                app:tint="@color/colorNavy"
                android:contentDescription="Usuario" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/txtUserRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="DISPOSITIVO VALIDADOR"
            android:textColor="#90A4AE"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/cardUserIcon"
            app:layout_constraintTop_toTopOf="@id/cardUserIcon" />

        <TextView
            android:id="@+id/txtTerminalId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="ID TERMINAL: VAL-45021"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/cardUserIcon"
            app:layout_constraintStart_toEndOf="@id/cardUserIcon" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutUnidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/colorPrimaryDark"
            android:padding="8dp"
            app:layout_constraintTop_toBottomOf="@id/cardUserIcon">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UNIDAD ACTUAL"
                android:textColor="#90A4AE"
                android:textSize="10sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txtUnidadActual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="B-120"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#001a35"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp"
            app:layout_constraintTop_toBottomOf="@id/layoutUnidad">

            <ImageView
                android:id="@+id/imgWifiMenu"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_wifi_ok"
                android:contentDescription="Wifi" />

            <TextView
                android:id="@+id/txtWifiStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="OK"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgGpsMenu"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_diag_location"
                app:tint="@color/white"
                android:contentDescription="GPS" />

            <TextView
                android:id="@+id/txtGpsStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="OK"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgBatteryMenu"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_diag_battery"
                app:tint="@color/white"
                android:contentDescription="Batería" />

            <TextView
                android:id="@+id/txtBatteryMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="95%"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnMenuLogout"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_margin="16dp"
        android:background="@drawable/borde"
        android:drawableStart="@drawable/ic_refresh_red"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="DESVINCULAR / REINICIAR"
        android:textColor="@color/colorError"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>